{
  "brand": "Valkra Performance",
  "font": {
    "family": "Poppins, ui-sans-serif, system-ui, sans-serif",
    "weights": [300, 400, 500, 600, 700]
  },
  "color": {
    "brand-yellow": "#feea27",
    "on-yellow": "#000000",
    "performance": "#feea27",
    "development": "#0096ff",
    "night": "#111111"
  },
  "theme": {
    "light": {
      "surface": "#ffffff",
      "surface-subtle": "#fafafa",
      "surface-raised": "#ffffff",
      "surface-tint": "#f5f5f5",
      "ink": "#1a1a1a",
      "ink-soft": "#555555",
      "ink-muted": "#666666",
      "border": "rgba(0,0,0,0.06)",
      "border-control": "rgba(0,0,0,0.45)",
      "focus": "#1a1a1a"
    },
    "dark": {
      "surface": "#0d0d0d",
      "surface-subtle": "#141414",
      "surface-raised": "#161616",
      "surface-tint": "#1c1c1c",
      "ink": "#f5f5f5",
      "ink-soft": "#c2c2c2",
      "ink-muted": "#a3a3a3",
      "border": "rgba(255,255,255,0.08)",
      "border-control": "rgba(255,255,255,0.4)",
      "focus": "#feea27"
    }
  },
  "radius": { "control": "8px", "card": "12px", "pill": "999px" },
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 120],
  "content-width": "1134px",
  "motion": {
    "durations-ms": [150, 300, 600, 1000],
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
